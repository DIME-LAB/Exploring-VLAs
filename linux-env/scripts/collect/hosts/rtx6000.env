# Source only for the exact rtx6000 host profile; shared venv files remain read-only.
rtx6000_python="$(cd "$(dirname "${BASH_SOURCE[0]}")/rtx6000-python" && pwd)"
case ":${PYTHONPATH:-}:" in
    *":$rtx6000_python:"*) ;;
    *) export PYTHONPATH="$rtx6000_python${PYTHONPATH:+:$PYTHONPATH}" ;;
esac
unset rtx6000_python
