<?xml version="1.0"?>
<!-- Reference: ~/ros2_ws/src/jetank_description/urdf/jetank_sensors.xacro -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="so_arm101">

  <!-- Fix the base to the world so the robot doesn't fall -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base"/>
  </joint>

  <!-- ros2_control hardware interface for Ignition Gazebo -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="shoulder_pan">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="shoulder_lift">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="elbow_flex">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="wrist_flex">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="wrist_roll">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="gripper_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo ros2_control plugin — loads controller_manager with our controller config.
       NOTE: uses ros2_controllers_gazebo.yaml (position-only command interface for
       arm_controller), NOT the default ros2_controllers.yaml. The default's
       position+velocity dual-mode is for Isaac Sim's PD feed-forward; Linux's
       gz_ros2_control can't handle multi-command-mode joints. See
       docs/GAZEBO_LINUX_LIMITATION.md for the full story. -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find so_arm101_moveit_config)/config/ros2_controllers_gazebo.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- Gazebo materials for each link -->
  <gazebo reference="base">
    <material>
      <ambient>1.0 0.82 0.12 1</ambient>
      <diffuse>1.0 0.82 0.12 1</diffuse>
    </material>
  </gazebo>

  <gazebo reference="shoulder">
    <material>
      <ambient>0.1 0.1 0.1 1</ambient>
      <diffuse>0.1 0.1 0.1 1</diffuse>
    </material>
  </gazebo>

  <gazebo reference="upper_arm">
    <material>
      <ambient>1.0 0.82 0.12 1</ambient>
      <diffuse>1.0 0.82 0.12 1</diffuse>
    </material>
  </gazebo>

  <gazebo reference="lower_arm">
    <material>
      <ambient>1.0 0.82 0.12 1</ambient>
      <diffuse>1.0 0.82 0.12 1</diffuse>
    </material>
  </gazebo>

  <gazebo reference="wrist">
    <material>
      <ambient>0.1 0.1 0.1 1</ambient>
      <diffuse>0.1 0.1 0.1 1</diffuse>
    </material>
  </gazebo>

  <gazebo reference="gripper">
    <material>
      <ambient>1.0 0.82 0.12 1</ambient>
      <diffuse>1.0 0.82 0.12 1</diffuse>
    </material>
  </gazebo>

  <gazebo reference="jaw">
    <material>
      <ambient>1.0 0.82 0.12 1</ambient>
      <diffuse>1.0 0.82 0.12 1</diffuse>
    </material>
  </gazebo>

  <gazebo reference="camera_mount">
    <material>
      <ambient>1.0 0.82 0.12 1</ambient>
      <diffuse>1.0 0.82 0.12 1</diffuse>
    </material>
  </gazebo>

  <gazebo reference="usb_camera">
    <material>
      <ambient>0.1 0.1 0.1 1</ambient>
      <diffuse>0.1 0.1 0.1 1</diffuse>
    </material>
  </gazebo>

  <!-- Wrist camera. Re-parented from `camera_link` to `usb_camera` because
       Gazebo Harmonic's Ogre2 won't create a render context for a sensor on
       a geometry-less link (camera_link is a bare ROS-convention frame — no
       <visual>/<collision>). The URDF transform from usb_camera to
       camera_link (xyz="0 0.0139 0" rpy="1.5708 0 1.5708") is folded into
       this sensor's <pose>. `ignition_frame_id` stays `camera_link` so
       downstream /wrist_camera Image messages carry the original frame_id. -->
  <gazebo reference="usb_camera">
    <sensor name="wrist_camera" type="camera">
      <pose>0 0.0139 0 1.5708 0 1.5708</pose>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <ignition_frame_id>camera_link</ignition_frame_id>
      <camera name="wrist_camera">
        <horizontal_fov>1.7453</horizontal_fov>
        <image>
          <!-- 640x480 matches the real RealSense wrist view and keeps macOS
               Ogre2 render rate above 10 Hz. Raise to 1280x720 only if a
               downstream recording needs it and you're OK with ~0.5 Hz. -->
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.01</near>
          <far>10.0</far>
        </clip>
      </camera>
      <topic>wrist_camera</topic>
      <camera_info_topic>wrist_camera/camera_info</camera_info_topic>
    </sensor>
  </gazebo>

  <!-- Top camera (tabletop top-down view for pick-and-place datasets).
       Resolution 640x480 @ 30 fps R8G8B8 to match the real-flow RealSense top
       camera (see LEROBOT_GUIDE.md). Mounted to a fixed top_camera_link 60 cm
       above world origin, rotated so the optical axis points -Z (down). -->
  <link name="top_camera_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual>
      <geometry><box size="0.04 0.04 0.02"/></geometry>
      <material name="top_camera_black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
  </link>

  <joint name="top_camera_joint" type="fixed">
    <parent link="world"/>
    <child link="top_camera_link"/>
    <!-- 60 cm above origin; rpy rotates camera +X (image forward) to -Z world. -->
    <origin xyz="0 0 0.6" rpy="0 1.5708 0"/>
  </joint>

  <gazebo reference="top_camera_link">
    <sensor name="top_camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <ignition_frame_id>top_camera_link</ignition_frame_id>
      <camera name="top_camera">
        <horizontal_fov>1.2</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>5.0</far>
        </clip>
      </camera>
      <topic>top_camera</topic>
      <camera_info_topic>top_camera/camera_info</camera_info_topic>
    </sensor>
  </gazebo>

</robot>
